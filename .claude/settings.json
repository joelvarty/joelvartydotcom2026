{
	"mcpServers": {
		"Agility-CMS": {
			"transport": "http",
			"endpoint": "https://mcp.agilitycms.com/api/mcp"
		}
	},
	"defaultMode": "acceptEdits",
	"permissions": {
		"allow": [
			"mcp__Agility-CMS__*",
			"mcp__chrome-devtools__*",
			"mcp__playwright__*",
			"Bash",
			"Edit",
			"Read",
			"Write",
			"WebFetch(https://mcp.agilitycms.com/*)",
			"WebFetch(https://cdn.agilitycms.com/*)",
			"WebFetch(https://*.aglty.io/*)"
		]
	}
}